---
import Layout from "../layouts/layout.astro";
import HeroBanner from "../components/HeroBanner.astro";
import CarruselInfo from "../components/CarruselInfo.astro";
---

<Layout title="neCyberWiki | Inicio">
  <HeroBanner />

  <CarruselInfo />
  <section class="two-columns">
    <div class="two-columns__left">
      <h2>¿Por qué existe neCyberWiki?</h2>
      <p>
        La idea es reunir apuntes, rutas y recursos útiles para aprender
        ciberseguridad de forma clara y accesible.
      </p>
      <p>
        No hace falta empezar sabiéndolo todo. Lo importante es tener una ruta,
        criterio y constancia.
      </p>
    </div>

    <aside class="two-columns__right">
      <div class="info-card">
        <h3>Empieza por aquí</h3>
        <ul>
          <li><a href="/fundamentos">Fundamentos</a></li>
          <li><a href="/redes">Redes</a></li>
          <li><a href="/roadmap">Roadmap</a></li>
          <li><a href="/etica">Ética</a></li>
        </ul>
      </div>
    </aside>
  </section>
</Layout>

<style>
  .two-columns {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: 3rem;
  }

  .two-columns__left,
  .two-columns__right {
    min-width: 0;
  }

  .two-columns__left h2 {
    margin-bottom: 1rem;
  }

  .two-columns__left p {
    margin-bottom: 1rem;
    max-width: 65ch;
  }

  .info-card {
    background: #111827;
    border: 1px solid #2f3945;
    border-radius: 8px;
    padding: 1.5rem;
  }

  .info-card h3 {
    margin-bottom: 1rem;
    color: #4ade80;
  }

  .info-card ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .info-card li + li {
    margin-top: 0.75rem;
  }

  @media (max-width: 900px) {
    .top-strip__inner,
    .two-columns {
      grid-template-columns: 1fr;
    }
  }
</style>
