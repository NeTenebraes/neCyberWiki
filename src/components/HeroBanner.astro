---
const {
  title = "neCyberWiki",
  subtitle = "NeTenebrae",
  mainTitle = "Aprende gratis Ciberseguridad",
  description = "Accede a todos mis recursos de ciberseguridad sin ningun tipo de costo",
  primaryButtonText = "Ver Roadmaps",
  secondaryButtonText = "Contáctame",
  characterImageSrc = "components/HeroBanner/character.webp", // Asegúrate de tener tu imagen aquí
  cubeColor = "#1A1D23",
} = Astro.props;
---

<section class="hero-container">
  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-greeting">
        <span>{subtitle} • {title}</span>
      </div>

      <h1 class="hero-main-title">
        <Fragment set:html={mainTitle} />
      </h1>
      <p class="hero-description">{description}</p>

      <div class="hero-cta">
        <a href="/proyectos" class="btn-primary">
          {primaryButtonText} →
        </a>

        <a href="#wiki" class="btn-tertiary"> Explora la Wiki </a>

        <a href="/contacto" class="btn-secondary btn-contact-full">
          {secondaryButtonText}
        </a>
      </div>
    </div>

    <div class="hero-image-wrapper">
      <div class="cube" style={`--cube-color: ${cubeColor};`}></div>
      <img src={characterImageSrc} alt="Personaje" class="hero-character" />
    </div>
  </div>

  <div class="hero-notice" aria-label="Aviso de uso ético">
    <div class="hero-notice__viewport">
      <div class="hero-notice__track">
        <div class="hero-notice__group">
          <span class="hero-notice__label">Importante</span>
          <span class="hero-notice__text">
            Uso educativo y ético únicamente. No ejecutes nada en producción ni
            sobre datos reales. Lee primero
            <a
              href="https://netenebraes.github.io/neCyberWiki/Ética-en-la-Ciberseguridad"
              target="_blank"
              rel="noopener noreferrer"
            >
              Ética en la Ciberseguridad
            </a>.
          </span>
        </div>

        <div class="hero-notice__group" aria-hidden="true">
          <span class="hero-notice__label">Importante</span>
          <span class="hero-notice__text">
            Uso educativo y ético únicamente. No ejecutes nada en producción ni
            sobre datos reales. Lee primero
            <a
              href="https://netenebraes.github.io/neCyberWiki/Ética-en-la-Ciberseguridad"
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
            >
              Ética en la Ciberseguridad
            </a>.
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* 1. ANCHO TOTAL: Se mantiene igual para abarcar toda la pantalla */
  .hero-container {
    width: 100%;
    background-color: #0d1117;
    padding: 0;
    overflow: hidden;
    position: relative;
  }

  /* 2. CONTENEDOR INTERNO: Alineación TESTING */
  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: center; /* Centra el bloque entero */
    align-items: center;
    gap: 6rem; /* Ajusta este gap para acercar/alejar */
    padding: 0 2rem;
  }

  .hero-content {
    flex: 1;
    max-width: 500px; /* Tamaño máximo para lectura cómoda */
  }

  /* Estilos de texto */
  .hero-greeting {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #4ade80;
    font-weight: 500;
  }

  .hero-main-title {
    font-size: 3.5rem;
    color: white;
    line-height: 1.1;
    margin: 0;
  }

  .hero-description {
    font-size: 1.1rem;
    color: #c9d1d9;
    margin-bottom: 2.5rem;
  }

  /* BOTONES: dos arriba, uno abajo ocupando ambas columnas */
  .hero-cta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .btn-primary {
    background: #2ea44f;
    color: white;
    padding: 0.8rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .btn-secondary {
    background: transparent;
    color: white;
    border: 1px solid #c9d1d9;
    padding: 0.8rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .btn-tertiary {
    background: transparent;
    color: #4ade80;
    border: 1px solid #253041;
    padding: 0.8rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .btn-contact-full {
    grid-column: 1 / -1;
  }

  /* IMAGEN Y CUBO: Ajuste para que el personaje no desborde TESTING */
  .hero-image-wrapper {
    flex-shrink: 0;
    width: 520px;
    height: 520px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .cube {
    width: 550px;
    height: 550px;
    background: var(--cube-color);
    position: absolute;
    transform: rotate(45deg);
    opacity: 0.3; /* Un poco más sutil */
  }

  .hero-character {
    padding-top: 17rem;
    width: 40rem;
    max-width: none;
    z-index: 1;
  }

  /* BANNER PEQUEÑO DE ÉTICA */
  .hero-notice {
    width: 100%;
    border-top: 1px solid #1f2937;
    border-bottom: 1px solid #1f2937;
    background: #0b1220;
    overflow: hidden;
  }

  .hero-notice__viewport {
    width: 100%;
    overflow: hidden;
  }

  .hero-notice__track {
    width: max-content;
    display: flex;
    align-items: center;
    gap: 2.5rem;
    animation: heroTicker 24s linear infinite;
    will-change: transform;
  }

  .hero-notice__group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
    padding: 0.55rem 0;
  }

  .hero-notice__label {
    flex-shrink: 0;
    color: #4ade80;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    padding-left: 1rem;
  }

  .hero-notice__text {
    color: #c9d1d9;
    font-size: 0.82rem;
    line-height: 1;
  }

  .hero-notice__text a {
    color: #4ade80;
    text-decoration: none;
  }

  .hero-notice__text a:hover {
    text-decoration: underline;
  }

  .hero-notice:hover .hero-notice__track {
    animation-play-state: paused;
  }

  @keyframes heroTicker {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 1.25rem));
    }
  }

  /* RESPONSIVE INITIAL EXPERIMENTAL */
  @media (max-width: 900px) {
    .hero-inner {
      flex-direction: column-reverse; /* Imagen debajo del texto en móvil | NECESITA ARREGLOS */
      text-align: center;
      gap: 3rem;
    }

    .hero-cta {
      grid-template-columns: 1fr;
      justify-content: center;
    }

    .btn-contact-full {
      grid-column: auto;
    }

    .hero-description {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-notice__group {
      gap: 0.55rem;
      padding: 0.5rem 0;
    }

    .hero-notice__text {
      font-size: 0.76rem;
    }

    .hero-notice__track {
      animation-duration: 18s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-notice__track {
      animation: none;
      transform: none;
    }
  }
</style>
