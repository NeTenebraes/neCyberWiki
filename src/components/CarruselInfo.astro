    will-change: transform;
  }

  .carousel__slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
  }

  .carousel__content {
    min-height: 320px;
    padding: 2.5rem 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: radial-gradient(
      circle at top right,
      rgba(74, 222, 128, 0.08),
      transparent 28%
    );
  }

  .carousel__index {
    display: inline-block;
    margin-bottom: 0.85rem;
    color: #4ade80;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .carousel__slide h3 {
    margin: 0 0 0.85rem;
    color: #4ade80;
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    line-height: 1.02;
  }

  .carousel__slide p {
    margin: 0 0 1.25rem;
    color: #c9d1d9;
    max-width: 58ch;
    font-size: 1rem;
    line-height: 1.8;
  }

  .carousel__link {
