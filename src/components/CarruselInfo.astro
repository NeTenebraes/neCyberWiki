<section class="carousel-shell">
  <div class="carousel-header">
    <p class="carousel-kicker">Explora la wiki</p>
    <h2>Tres caminos para aprender ciberseguridad</h2>
  </div>

  <carrusel-info class="carousel" aria-label="Carrusel de áreas principales">
    <div class="carousel__viewport">
      <div class="carousel__track" data-track>
        <article class="carousel__slide">
          <div class="carousel__content">
            <span class="carousel__index">01</span>
            <h3>Fundamentos</h3>
            <p>
              Construye bases reales en sistemas, terminal, redes y conceptos
              esenciales para entender la ciberseguridad desde cero.
            </p>
            <a href="/fundamentos" class="carousel__link">Ir a fundamentos →</a>
          </div>
        </article>

        <article class="carousel__slide">
          <div class="carousel__content">
            <span class="carousel__index">02</span>
            <h3>Red Team</h3>
            <p>
              Aprende reconocimiento, explotación, metodología ofensiva y
              práctica en laboratorios para desarrollar criterio técnico.
            </p>
            <a href="/red-team" class="carousel__link">Explorar Red Team →</a>
          </div>
        </article>

        <article class="carousel__slide">
          <div class="carousel__content">
            <span class="carousel__index">03</span>
            <h3>Blue Team</h3>
            <p>
              Trabaja detección, análisis, hardening, monitoreo y defensa para
              entender cómo proteger sistemas y responder a incidentes.
            </p>
            <a href="/blue-team" class="carousel__link">Explorar Blue Team →</a>
          </div>
        </article>
      </div>
    </div>

    <div class="carousel__footer">
      <div class="carousel__dots" data-dots>
        <button
          class="carousel__dot is-active"
          type="button"
          aria-label="Ver slide 1"
          aria-current="true"></button>
        <button
          class="carousel__dot"
          type="button"
          aria-label="Ver slide 2"
          aria-current="false"></button>
        <button
          class="carousel__dot"
          type="button"
          aria-label="Ver slide 3"
          aria-current="false"></button>
      </div>
    </div>
  </carrusel-info>
</section>

<script>
  class CarruselInfo extends HTMLElement {
    track: HTMLElement | null = null;
    slides: HTMLElement[] = [];
    dots: HTMLButtonElement[] = [];
    current = 0;
    interval: number | null = null;
    prefersReducedMotion = false;

    connectedCallback() {
      if (this.dataset.ready === "true") return;
      this.dataset.ready = "true";

      this.track = this.querySelector("[data-track]");
      this.slides = [...this.querySelectorAll(".carousel__slide")] as HTMLElement[];
      this.dots = [...this.querySelectorAll(".carousel__dot")] as HTMLButtonElement[];
      this.current = 0;
      this.interval = null;
      this.prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      this.update();

      this.dots.forEach((dot, index) => {
        dot.addEventListener("click", () => {
          this.goTo(index);
          this.restart();
        });
      });

      this.addEventListener("mouseenter", () => this.stop());
      this.addEventListener("mouseleave", () => this.start());
      this.addEventListener("focusin", () => this.stop());
      this.addEventListener("focusout", () => this.start());

      this.start();
    }

    update() {
      if (!this.track) return;
      this.track.style.transform = `translateX(-${this.current * 100}%)`;

      this.slides.forEach((slide, index) => {
        slide.setAttribute("aria-hidden", index === this.current ? "false" : "true");
      });

      this.dots.forEach((dot, index) => {
        const active = index === this.current;
        dot.classList.toggle("is-active", active);
        dot.setAttribute("aria-current", active ? "true" : "false");
      });
    }

    goTo(index: number) {
      this.current = index;
      this.update();
    }

    next() {
      this.current = (this.current + 1) % this.slides.length;
      this.update();
    }

    start() {
      if (this.prefersReducedMotion || this.slides.length <= 1) return;
      this.stop();
      this.interval = window.setInterval(() => this.next(), 5000);
    }

    stop() {
      if (this.interval) {
        window.clearInterval(this.interval);
        this.interval = null;
      }
    }

    restart() {
      this.stop();
      this.start();
    }
  }

  if (!customElements.get("carrusel-info")) {
    customElements.define("carrusel-info", CarruselInfo);
  }
</script>

