    padding: 0.8rem 1rem;
    transition: 0.2s ease;
  }

  .carousel__link:hover {
    color: #4ade80;
    border-color: #4ade80;
  }

  .carousel__footer {
    border-top: 1px solid #1f2a3a;
    padding: 0.9rem 1rem 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .carousel__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
  }

  .carousel__dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    border: none;
    background: #334155;
    cursor: pointer;
    transition: 0.2s ease;
    padding: 0;
  }

  .carousel__dot.is-active {
    width: 26px;
    background: #4ade80;
  }

  @media (max-width: 900px) {
    .carousel-shell {
      padding: 1.75rem 1rem 1.25rem;
    }

    .carousel__viewport,
    .carousel__content {
      min-height: 360px;
    }

    .carousel__content {
      padding: 2rem 1.5rem;
    }

    .carousel__slide p {
      font-size: 0.98rem;
      line-height: 1.75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      transition: none;
    }
  }
</style>
